# =============================================================
# LingoFriends V2 — Environment Variables Template
# Copy to .env and fill in real values for local development.
# NEVER commit .env to git.
# =============================================================

# --- Database (server-side only) ---
# Docker dev: postgresql://postgres:dev@localhost:5432/lingofriends
DATABASE_URL=postgresql://user:password@localhost:5432/lingofriends

# --- AI Providers (server-side only — NO VITE_ prefix) ---
# Keys must NOT have the VITE_ prefix — they must never reach the browser bundle.
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# --- Google TTS (server-side only) ---
GOOGLE_TTS_API_KEY=

# --- Public (client-side visible, safe to expose) ---
VITE_APP_URL=http://localhost:5173
