# LingoFriends Environment Variables Template
# Copy this to .env and fill in your values

# ===================
# POCKETBASE
# ===================
VITE_POCKETBASE_URL=https://your-instance.pocketbase.io

# ===================
# GROQ
# Used for:
# - Llama 3.3 70B (fallback chat AI)
# - Whisper Large v3 (speech-to-text)
# ===================
VITE_GROQ_API_KEY=gsk_your_groq_api_key

# ===================
# DEEPINFRA
# Primary AI provider for production (GLM-5)
# Zero data retention, US data centre
# ===================
VITE_DEEPINFRA_API_KEY=your_deepinfra_api_key

# ===================
# ANTHROPIC
# Dev mode only - Claude Haiku/Sonnet
# Enable with VITE_DEV_MODE=true
# ===================
VITE_ANTHROPIC_API_KEY=sk-ant-your_anthropic_key

# ===================
# GOOGLE AI STUDIO (Gemini for translation)
# ===================
VITE_GOOGLE_AI_KEY=your_google_ai_key

# ===================
# GOOGLE CLOUD TTS
# Requires: Text-to-Speech API enabled in Google Cloud Console
# Get from: https://console.cloud.google.com/apis/credentials
# ===================
VITE_GOOGLE_TTS_KEY=your_google_cloud_tts_key

# ===================
# VERTEX AI (Anthropic models - EU data sovereignty)
# Optional: For Claude Haiku fallback on complex reasoning
# ===================
VITE_VERTEX_AI_KEY=your_vertex_ai_key

# ===================
# DEVELOPMENT
# ===================
VITE_DEBUG_MODE=false
